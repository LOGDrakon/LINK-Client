<Window x:Class="LINK.Example.WPF.Discovery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LINK Discovery (WPF)" Height="350" Width="500">

    <Grid Margin="10">
        <ListView ItemsSource="{Binding Watcher.Devices}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding DeviceInfo.Model}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PortName}" FontSize="12"/>
                        <TextBlock Text="{Binding DeviceInfo.Version}" FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
